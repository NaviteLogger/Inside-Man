{
  "name": "inside-man-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "gen-types": "openapi-typescript ../bff/openapi.yaml -o src/api-types.ts",
    "lint-spec": "redocly lint --config ../bff/redocly.yaml ../bff/openapi.yaml"
  },
  "dependencies": {
    "react": "19.2.0",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@redocly/cli": "^2.51.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "^26.4.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.1",
    "jsdom": "27.0.0",
    "openapi-typescript": "^7.13.0",
    "typescript": "5.9.3",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
